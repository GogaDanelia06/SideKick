{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.3",
      "postcss@<8.5.18": ">=8.5.18"
    }
  },
  "pnpmOverridesNote": "The overrides above force patched versions of two build-time deps that Next 16.2.11 still pins vulnerable (sharp, postcss). Both bumps stay within the same major, so they are safe. Remove each once a Next release ships the fix itself. Rationale: docs/DEPENDENCIES.md.",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed:prod": "tsx prisma/seed-prod.ts",
    "admin:grant": "tsx prisma/grant-admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@tabler/icons-react": "^3.36.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
