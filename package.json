{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10"
      }
    }
  },
  "pnpmOverridesNote": "Prisma's config loader (@prisma/config, in Prisma 6.19 and 7.10 alike) pins deepmerge-ts 7.1.5, which has a high advisory (GHSA-ggr8-5vv4-36mx, patched in 8.0.0). Prisma only calls the plain deepmerge(), which 8.x left unchanged. Remove the override once Prisma ships deepmerge-ts 8 itself. Rationale: docs/DEPENDENCIES.md.",
  "pnpmPeerRulesNote": "The three lint plugins inside eslint-config-next still declare ESLint 9 at most. They run on ESLint 10 through @eslint/compat (eslint.config.mjs), checked rule by rule. Remove each entry once the plugin declares ESLint 10 itself. Rationale: docs/DEPENDENCIES.md.",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed:prod": "tsx prisma/seed-prod.ts",
    "admin:grant": "tsx prisma/grant-admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "@tabler/icons-react": "^3.47.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
