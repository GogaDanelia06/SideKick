# Template for .env — copy this file, then fill in real values.
#
#   cp .env.example .env
#
# NEVER put real secrets here: this is the one .env* the repository tracks.
# Full reference: docs/DEPLOYMENT.md#environment-variables

# ── Required ────────────────────────────────────────────────────────────────

# Postgres. Locally this matches docker-compose.yml. In production use Neon's
# POOLED connection string (its host contains "-pooler").
DATABASE_URL="postgresql://USER@localhost:5432/sidekick_dev?schema=public"

# Signs the session JWT. Generate with:  openssl rand -base64 32
# Changing it signs every user out.
AUTH_SECRET=""

# ── Recommended ─────────────────────────────────────────────────────────────

# Canonical origin. Auth.js infers this on Vercel, but setting it explicitly
# stops callback URLs pointing at a preview domain.
AUTH_URL="http://localhost:3000"

# UNPOOLED connection string. Prisma Migrate needs a direct connection —
# migrations hang or fail through a pooler. Matters in production; locally it
# can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER@localhost:5432/sidekick_dev?schema=public"

# Canonical tags, sitemap and Open Graph.
# Defaults to https://sidekick.ge — see lib/seo/site.ts
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Optional ────────────────────────────────────────────────────────────────

# Enables the "Sign in with Google" button. Without BOTH values the provider is
# not registered at all.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Transactional email. The key alone does nothing until deliver() is
# implemented in lib/mail/send.ts — see docs/DEPLOYMENT.md#email
# RESEND_API_KEY=""
# MAIL_FROM="Sidekick <noreply@sidekick.ge>"

# ── Payments ────────────────────────────────────────────────────────────────
# Both Georgian banks are supported. A bank appears as a payment option only
# when its credentials are set, so you can launch with one and add the other
# later without a code change. With neither set, the billing screen says
# payments are not enabled and no plan can be bought.
#
# Bank of Georgia — from the BOG merchant portal.
# BOG_CLIENT_ID=""
# BOG_CLIENT_SECRET=""
# Only needed if BOG rotates its callback signing key; the current one is
# built in. https://api.bog.ge/docs/en/payments/standard-process/callback
# BOG_PUBLIC_KEY=""
#
# TBC — apikey comes from developers.tbcbank.ge, the client pair from the
# e-commerce agreement.
# TBC_API_KEY=""
# TBC_CLIENT_ID=""
# TBC_CLIENT_SECRET=""
