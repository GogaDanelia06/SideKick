generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum ChannelType {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WEBSITE
}

enum ChannelStatus {
  ACTIVE
  DELAYED
  OFF
}

enum ConversationStatus {
  NEW
  ACTIVE
  DONE
}

enum MessageSender {
  CUSTOMER
  AI
  OPERATOR
}

enum OrderStatus {
  NEW
  TO_SEND
  DONE
  CANCELLED
  PROBLEM
}

enum LeadStatus {
  NEW
  ACTIVE
  CLOSED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Georgian payment service providers. Both are supported; a business picks
/// one per payment, so a bank outage never blocks every customer at once.
enum PaymentProvider {
  BOG
  TBC
}

/// A payment's life: created when the customer is sent to the bank, then
/// settled once the bank's authoritative status is read back. Never advanced
/// from a callback body alone.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}
