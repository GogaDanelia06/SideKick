// Sidekick backend — multi-file Prisma schema (Postgres).
// Scope: Frontend + Backend only. AI reply engine and channel integrations
// are separate unbought modules; their tables store settings but nothing drives them yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection — used by the app at runtime. Serverless functions open
  // many short-lived connections, so a hosted Postgres (e.g. Neon) must be
  // reached through its pooler or it will exhaust connection limits.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection — used only for migrations, which can't run
  // over a pooler. Locally this is just the same URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum ChannelType {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WEBSITE
}

enum ChannelStatus {
  ACTIVE
  DELAYED
  OFF
}

enum ConversationStatus {
  NEW
  ACTIVE
  DONE
}

enum MessageSender {
  CUSTOMER
  AI
  OPERATOR
}

enum OrderStatus {
  NEW
  TO_SEND
  DONE
  CANCELLED
  PROBLEM
}

enum LeadStatus {
  NEW
  ACTIVE
  CLOSED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}
