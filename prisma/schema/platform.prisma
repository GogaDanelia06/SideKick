/// One day's count of one event on one page.
///
/// Deliberately aggregated rather than a row per hit: a busy site would write
/// millions of rows to answer a question that only ever needs a total, and raw
/// hits invite storing things — a session, an address — that would turn this
/// into personal data. One row per day per event per path stays tiny and can
/// never be traced back to a visitor.
model AnalyticsDaily {
  id    String   @id @default(cuid())
  /// Midnight UTC of the day being counted.
  day   DateTime @db.Date
  /// A name from TRACKED_EVENTS; anything else is rejected before it gets here.
  name  String
  /// The page it happened on. Empty for events that aren't page-specific.
  path  String   @default("")
  count Int      @default(0)

  @@unique([day, name, path])
  @@index([name, day])
}

/// How-to videos shown to every tenant under "Tutorials" in the dashboard.
/// Platform-owned, not tenant-owned: businesses read these, only the admin
/// panel writes them, so all customers see the same up-to-date guidance.
model Tutorial {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  published  Boolean  @default(true)
  titleKa    String
  titleEn    String
  descKa     String   @default("")
  descEn     String   @default("")
  /// Normalized to https://www.youtube.com/watch?v=<id> on save.
  youtubeUrl String
  /// Free-text grouping label ("დაწყება", "არხები"). Empty means ungrouped.
  categoryKa String   @default("")
  categoryEn String   @default("")
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([order])
}

/// Connection instructions shown beside each channel on the tenant's Channels
/// screen. One row per channel type, so the type itself is the key — there is
/// nothing to reorder and never more than one guide per channel.
model ChannelGuide {
  type       ChannelType @id
  published  Boolean     @default(true)
  /// Optional walkthrough video. Empty means text-only instructions.
  youtubeUrl String      @default("")
  /// Numbered steps, one per line.
  bodyKa     String      @default("")
  bodyEn     String      @default("")
  updatedAt  DateTime    @default(now()) @updatedAt
}
