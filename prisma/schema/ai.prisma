model AiConfig {
  id             String   @id @default(cuid())
  businessId     String   @unique
  languages      String[]
  style          String?
  length         String?
  emoji          String?
  addressForm    String?
  roles          String[]
  handoffRule    String?
  leadEnabled    Boolean  @default(false)
  leadRule       String?
  orderEnabled   Boolean  @default(false)
  orderRule      String?
  allowOrderEdit Boolean  @default(false)
  faqText        String?
  policies       String?
  prompt         String?
  /// How long to wait for the customer to stop typing before answering, in
  /// seconds. A person often sends three short messages instead of one long
  /// one, and answering the first of them means answering a question they had
  /// not finished asking. 0 answers immediately.
  replyDelaySec  Int      @default(30)
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Faq {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
