model AiConfig {
  id          String   @id @default(cuid())
  businessId  String   @unique
  languages   String[]
  style       String?
  length      String?
  emoji       String?
  addressForm String?
  roles       String[]
  handoffRule String?
  leadEnabled Boolean  @default(false)
  leadRule    String?
  orderEnabled Boolean @default(false)
  orderRule    String?
  allowOrderEdit Boolean @default(false)
  faqText     String?
  policies    String?
  prompt      String?
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Faq {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
