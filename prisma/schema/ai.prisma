// AI assistant configuration + FAQ. Stored settings only — the reply engine
// (Claude prompt generation / tester) is the unbought AI Module.

model AiConfig {
  id          String   @id @default(cuid())
  businessId  String   @unique
  languages   String[]
  style       String?
  length      String?
  emoji       String?
  addressForm String?
  roles       String[]
  handoffRule String?
  // Lead capture: toggle + what counts as a lead.
  leadEnabled Boolean  @default(false)
  leadRule    String?
  // Order taking: toggle + what counts as an order.
  orderEnabled Boolean @default(false)
  orderRule    String?
  // May the bot amend/cancel an existing order?
  allowOrderEdit Boolean @default(false)
  // Free-form "question → answer" pairs the bot should know.
  faqText     String?
  // Delivery / returns policy.
  policies    String?
  prompt      String?
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Faq {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
