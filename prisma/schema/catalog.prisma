model Product {
  id          String      @id @default(cuid())
  businessId  String
  name        String
  code        String
  photos      String[]
  price       Int
  discountPct Int?
  salePrice   Int?
  size        String?
  description String?
  quantity    Int         @default(0)
  params      Json?
  createdAt   DateTime    @default(now())
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@unique([businessId, code])
  @@index([businessId, createdAt])
}

model Channel {
  id         String        @id @default(cuid())
  businessId String
  type       ChannelType
  status     ChannelStatus @default(OFF)
  connected  Boolean       @default(false)
  /// The Page Access Token, which is what lets us send a reply back.
  ///
  /// Receiving needs nothing but the app secret; sending needs a credential for
  /// this specific page, issued when its owner connects it. So a channel can be
  /// perfectly able to take messages in and unable to answer them, and that is
  /// exactly the state a page linked by hand is in.
  ///
  /// Was called `tokens` and never read by anything. Renamed rather than left
  /// alongside a new field: one clearly named column beats two vague ones.
  accessToken String?
  /// The account's id on the platform itself — a Facebook Page id for FACEBOOK.
  ///
  /// Meta's webhook says which *page* an event happened on and never which
  /// business, so without this an inbound message has no tenant to belong to.
  /// It is the whole routing key: page id -> channel -> business.
  ///
  /// Null until the page is actually linked, which is why the type is optional
  /// and why the webhook treats "no match" as a message for somebody else.
  externalId String?
  lastSyncAt DateTime?

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, type])
  /// One page belongs to one tenant. Without this a page id typed into two
  /// accounts would make routing ambiguous, and a tenant could quietly capture
  /// another's conversations by claiming their page. Postgres lets nulls repeat,
  /// so unlinked channels are unaffected.
  @@unique([type, externalId])
}
