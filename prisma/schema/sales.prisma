model Conversation {
  id             String             @id @default(cuid())
  businessId     String
  channelId      String?
  customerName   String?
  customerRef    String?
  status         ConversationStatus @default(NEW)
  aiEnabled      Boolean            @default(true)
  assignedToId   String?
  botPausedUntil DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel        Channel?           @relation(fields: [channelId], references: [id])
  messages       Message[]
  lead           Lead?
  orders         Order[]

  @@index([businessId, createdAt])
  @@index([channelId])
  /// The AI service identifies a chat by the customer's id on its platform
  /// (a Facebook PSID, a phone number). This is what lets it ask for "the
  /// conversation with this customer" and get the same one back on a retry
  /// instead of a duplicate. Rows with no customerRef never collide, so
  /// conversations created in the dashboard are unaffected.
  @@unique([businessId, customerRef])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  text           String
  createdAt      DateTime      @default(now())
  deliveryStatus String?
  stoppedReason  String?
  /// The platform's own id for this message — Meta calls it `mid`.
  ///
  /// Meta re-sends an event whenever we fail to answer 200 within five seconds,
  /// and a slow database write is enough to miss that. Without a key to
  /// recognise the repeat by, the retry lands as a second copy: the tenant sees
  /// the customer say the same thing twice and the AI answers it twice.
  ///
  /// Null for anything typed in the dashboard or written by the AI, which have
  /// no platform id and arrive exactly once.
  externalId     String?
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  /// Scoped to the conversation rather than global so the constraint stays true
  /// even if two platforms ever hand us the same id. Nulls repeat, so dashboard
  /// and AI messages are unaffected.
  @@unique([conversationId, externalId])
}

model Lead {
  id             String        @id @default(cuid())
  businessId     String
  conversationId String?       @unique
  name           String?
  phone          String?
  interest       String?
  source         String?
  status         LeadStatus    @default(NEW)
  comment        String?
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([businessId, createdAt])
}

model Order {
  id             String        @id @default(cuid())
  businessId     String
  conversationId String?
  customerName   String?
  phone          String?
  email          String?
  address        String?
  total          Int           @default(0)
  status         OrderStatus   @default(NEW)
  note           String?
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  items          OrderItem[]

  @@index([businessId, createdAt])
  @@index([conversationId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  codeSnapshot String
  nameSnapshot String
  qty          Int
  price        Int
  lineTotal    Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
