model Business {
  id            String         @id @default(cuid())
  name          String
  field         String?
  email         String?
  phone         String?
  description   String?
  contactInfo   String?
  workingHours  String?
  site          String?
  branches      String?
  extra         String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  subscription  Subscription?
  payments      Payment[]
  products      Product[]
  channels      Channel[]
  conversations Conversation[]
  leads         Lead[]
  orders        Order[]
  aiConfig      AiConfig?
  faqs          Faq[]
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  nameEn        String         @default("")
  /// Monthly price. price3m / price12m hold the explicit multi-month prices —
  /// null means "fall back to price × months", so an unset plan still works.
  price         Int
  price3m       Int?
  price12m      Int?
  msgLimit      Int
  channelCap    Int
  userCap       Int
  productCap    Int
  /// Extra bullet lines shown on the pricing card, on top of the ones derived
  /// from the caps above. Free-form so the admin can write anything.
  extrasKa      String[]       @default([])
  extrasEn      String[]       @default([])
  featured      Boolean        @default(false)
  subscriptions Subscription[]
  payments      Payment[]
  updatedAt     DateTime       @default(now()) @updatedAt
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  planId     String
  status     SubscriptionStatus @default(TRIAL)
  msgUsed    Int                @default(0)
  renewsAt   DateTime?
  cardRef    String?
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan       Plan               @relation(fields: [planId], references: [id])
}

/// One attempt to pay for a subscription period — created before the customer
/// is sent to the bank, so an abandoned or failed payment leaves a record too.
/// This is also the billing history the customer sees.
model Payment {
  id          String           @id @default(cuid())
  businessId  String
  description String
  /// Whole lari. Plan prices are whole lari, so there is no tetri to lose.
  amount      Int
  currency    String           @default("GEL")
  date        DateTime         @default(now())
  status      PaymentStatus    @default(PENDING)
  provider    PaymentProvider?
  /// The bank's own id — BOG order id or TBC payId. Unique per provider so a
  /// callback delivered twice cannot be applied twice.
  providerRef String?
  /// What was bought. Kept even if the plan is later renamed or deleted.
  planId      String?
  months      Int              @default(1)
  paidAt      DateTime?
  failReason  String?
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        Plan?            @relation(fields: [planId], references: [id])

  @@unique([provider, providerRef])
  @@index([businessId, date])
}

model SiteStat {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  labelKa   String
  labelEn   String
  order     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model SiteFaq {
  id         String   @id @default(cuid())
  questionKa String
  questionEn String
  answerKa   String
  answerEn   String
  order      Int      @default(0)
  published  Boolean  @default(true)
  updatedAt  DateTime @default(now()) @updatedAt
}

/// Every simple editable text on the public site, addressed by a stable key
/// (e.g. "story_title", "terms_body", "contact_email"). One table instead of a
/// model per section — a new editable field costs a key, not a migration.
/// A key that is absent falls back to the hardcoded default in lib/content,
/// so the site always renders even before an admin touches anything.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueKa   String
  valueEn   String   @default("")
  updatedAt DateTime @updatedAt
}

/// Homepage carousel slide. Media is optional — with none, the slide falls back
/// to one of the built-in animated mocks (`mock`).
model HeroSlide {
  id         String          @id @default(cuid())
  order      Int             @default(0)
  published  Boolean         @default(true)
  /// Uploaded image/video URL. Null = use `mock`.
  mediaUrl   String?
  mediaType  String?
  /// Built-in mock to show when there's no media: chat | dashboard | tester
  mock       String?
  badgeKa    String          @default("")
  badgeEn    String          @default("")
  titleKa    String
  titleEn    String
  textKa     String
  textEn     String
  ctaLabelKa String          @default("")
  ctaLabelEn String          @default("")
  /// Where "learn more" goes. Defaults to the pricing page.
  ctaUrl     String          @default("/pricing")
  stats      HeroSlideStat[]

  updatedAt DateTime @default(now()) @updatedAt

  @@index([order])
}

/// A single animated figure inside a slide's mock panel. The figure starts at
/// `baseValue` and ticks by a random amount in [changeMin, changeMax] every
/// random interval in [intervalMinMs, intervalMaxMs] — which is what makes the
/// hero look alive without inventing a fake total.
model HeroSlideStat {
  id            String    @id @default(cuid())
  slideId       String
  order         Int       @default(0)
  labelKa       String
  labelEn       String
  baseValue     Float     @default(0)
  changeMin     Float     @default(0)
  changeMax     Float     @default(0)
  intervalMinMs Int       @default(2000)
  intervalMaxMs Int       @default(6000)
  /// Rendered right after the number, e.g. "₾" or "%".
  suffix        String    @default("")
  slide         HeroSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@index([slideId, order])
}

/// "What Sidekick does" boxes on the landing page.
model Benefit {
  id        String  @id @default(cuid())
  order     Int     @default(0)
  published Boolean @default(true)
  /// Tabler icon name, e.g. "IconClockHour4". Resolved through an allow-list.
  icon      String  @default("IconSparkles")
  titleKa   String
  titleEn   String
  descKa    String
  descEn    String

  updatedAt DateTime @default(now()) @updatedAt

  @@index([order])
}

/// One numbered section of a legal document (Terms / Privacy / Data protection).
/// Kept as rows rather than one giant text field so the admin edits section by
/// section and the page keeps its heading structure — which is also what makes
/// these documents readable and linkable.
model LegalSection {
  id        String  @id @default(cuid())
  /// Which document: "terms" | "privacy" | "data-protection"
  doc       String
  order     Int     @default(0)
  published Boolean @default(true)
  headingKa String
  headingEn String
  /// Paragraphs, separated by a blank line.
  bodyKa    String  @default("")
  bodyEn    String  @default("")
  /// Bullet points, one per line. Empty means no list.
  bulletsKa String  @default("")
  bulletsEn String  @default("")

  updatedAt DateTime @default(now()) @updatedAt

  @@index([doc, order])
}

/// SEO overrides for one public page, keyed by its path ("/", "/pricing", …).
///
/// Every field is optional in effect: an empty string means "use the default
/// derived in lib/seo", so clearing a box in the admin panel restores the
/// built-in value rather than blanking the tag. A page with no row at all
/// behaves exactly as it did before this table existed.
model PageSeo {
  path          String   @id
  title         String   @default("")
  description   String   @default("")
  /// Absolute URL, or empty to derive it from `path`. Wrong values here can
  /// de-index a page, so the admin form validates it.
  canonical     String   @default("")
  /// False emits robots noindex,nofollow for this page.
  indexable     Boolean  @default(true)
  ogTitle       String   @default("")
  ogDescription String   @default("")
  /// Empty falls back to the generated /opengraph-image.
  ogImageUrl    String   @default("")
  updatedAt     DateTime @default(now()) @updatedAt
}

/// How-to videos shown to every tenant under "Tutorials" in the dashboard.
/// Platform-owned, not tenant-owned: businesses read these, only the admin
/// panel writes them, so all customers see the same up-to-date guidance.
model Tutorial {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  published  Boolean  @default(true)
  titleKa    String
  titleEn    String
  descKa     String   @default("")
  descEn     String   @default("")
  /// Normalized to https://www.youtube.com/watch?v=<id> on save.
  youtubeUrl String
  /// Free-text grouping label ("დაწყება", "არხები"). Empty means ungrouped.
  categoryKa String   @default("")
  categoryEn String   @default("")
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([order])
}

/// Connection instructions shown beside each channel on the tenant's Channels
/// screen. One row per channel type, so the type itself is the key — there is
/// nothing to reorder and never more than one guide per channel.
model ChannelGuide {
  type       ChannelType @id
  published  Boolean     @default(true)
  /// Optional walkthrough video. Empty means text-only instructions.
  youtubeUrl String      @default("")
  /// Numbered steps, one per line.
  bodyKa     String      @default("")
  bodyEn     String      @default("")
  updatedAt  DateTime    @default(now()) @updatedAt
}

/// "What Sidekick gives you" boxes on the pricing page.
model ServiceBox {
  id        String  @id @default(cuid())
  order     Int     @default(0)
  published Boolean @default(true)
  icon      String  @default("IconSparkles")
  titleKa   String
  titleEn   String
  bodyKa    String
  bodyEn    String

  updatedAt DateTime @default(now()) @updatedAt

  @@index([order])
}
