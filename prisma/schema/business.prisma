model Business {
  id            String         @id @default(cuid())
  name          String
  field         String?
  email         String?
  phone         String?
  description   String?
  contactInfo   String?
  workingHours  String?
  site          String?
  branches      String?
  extra         String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  subscription  Subscription?
  payments      Payment[]
  products      Product[]
  channels      Channel[]
  videos        Video[]
  conversations Conversation[]
  leads         Lead[]
  orders        Order[]
  aiConfig      AiConfig?
  faqs          Faq[]
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  nameEn        String         @default("")
  price         Int
  msgLimit      Int
  channelCap    Int
  userCap       Int
  productCap    Int
  featured      Boolean        @default(false)
  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  planId     String
  status     SubscriptionStatus @default(TRIAL)
  msgUsed    Int                @default(0)
  renewsAt   DateTime?
  cardRef    String?
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan       Plan               @relation(fields: [planId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  businessId  String
  description String
  amount      Int
  date        DateTime @default(now())
  providerRef String?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}

model SiteStat {
  id      String @id @default(cuid())
  key     String @unique
  value   String
  labelKa String
  labelEn String
  order   Int    @default(0)
}

model SiteFaq {
  id         String  @id @default(cuid())
  questionKa String
  questionEn String
  answerKa   String
  answerEn   String
  order      Int     @default(0)
  published  Boolean @default(true)
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueKa   String
  valueEn   String   @default("")
  updatedAt DateTime @updatedAt
}
