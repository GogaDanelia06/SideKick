model Business {
  id            String         @id @default(cuid())
  name          String
  field         String?
  email         String?
  phone         String?
  description   String?
  contactInfo   String?
  workingHours  String?
  site          String?
  branches      String?
  extra         String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  subscription  Subscription?
  payments      Payment[]
  products      Product[]
  channels      Channel[]
  conversations Conversation[]
  leads         Lead[]
  orders        Order[]
  aiConfig      AiConfig?
  faqs          Faq[]
}
